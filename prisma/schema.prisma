// PURE Academy & Arizona Club Pickleball — Season Management CRM
// ---------------------------------------------------------------------------
// Data model is the spine of this system. Per the requirements spec (§2):
//   "Get these entities right and the rest follows. Get them wrong and every
//    report is a workaround."
//
// Runs on PostgreSQL (managed migrations, encryption at rest, backups). The
// schema keeps a deliberately portable shape:
//   - enum-like values are Strings with the allowed set documented inline and
//     validated in application code (see src/lib/enums.ts). This trades
//     DB-level enum enforcement for zero-churn value changes across seasons;
//     CHECK constraints can be layered via a migration if desired.
//   - "arrays" are modeled as related rows or JSON strings.
//   - money is stored as INTEGER CENTS (never floats) to avoid rounding drift.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is used for migrations. With a connection pooler (PgBouncer,
  // Supabase, Neon) point DATABASE_URL at the pooler and DIRECT_URL at the
  // direct connection. Locally both are the same.
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// TENANCY (SaaS)
// ===========================================================================

/// A licensed customer of the platform — PURE itself (the primary org) plus any
/// school, club, or company we license the software to. One shared deployment
/// and database serve every org; a request is mapped to its org by hostname
/// (custom domain or "<slug>.<platform-domain>" subdomain), and all tenant data
/// carries an organizationId so orgs never see each other's records. Branding,
/// contact identity, locale, and integration credentials live here so a new
/// org can be stood up as a fully self-branded instance without a code change.
model Organization {
  id            String   @id @default(cuid())
  /// URL-safe short name; also the default subdomain (e.g. "pure" → pure.app).
  slug          String   @unique
  /// Display name shown in the app chrome and communications ("PURE Academy").
  name          String
  /// Legal entity name for receipts/contracts, when different from `name`.
  legalName     String?
  /// The ONE primary org (PURE). Used as the fallback tenant and the "main site"
  /// whose feature updates roll out to everyone. Exactly one row should be true.
  isPrimary     Boolean  @default(false)
  /// ACTIVE | SUSPENDED — a suspended org's public + portal surfaces are closed.
  status        String   @default("ACTIVE")

  // --- Hostname routing -----------------------------------------------------
  /// Custom production domain, if the org has one (e.g. "portal.school.edu").
  primaryHost   String?  @unique
  /// Extra hostnames that also resolve to this org (JSON array of strings) —
  /// apex+www, staging domains, a vanity domain, etc.
  altHosts      Json?

  // --- Branding -------------------------------------------------------------
  /// Primary logo (app chrome, emails). Served URL or /brand path.
  logoUrl       String?
  /// Optional secondary/co-brand logo shown alongside the primary (PURE pairs
  /// its Academy mark with the Pickleball & Padel mark).
  secondaryLogoUrl String?
  faviconUrl    String?
  /// Brand colors as hex (#0f766e). Drive the CSS theme variables per org.
  primaryColor  String?
  accentColor   String?

  // --- Contact identity (communications) ------------------------------------
  /// From-name and address for outbound email ("PURE Academy",
  /// "team@purepickleball.com"). Falls back to platform defaults when unset.
  fromName      String?
  fromEmail     String?
  supportEmail  String?
  supportPhone  String?
  /// Short brand token prefixed on outbound SMS ("PURE Academy: …").
  smsBrand      String?
  /// IANA timezone + ISO currency for money/schedule display.
  timezone      String?  @default("America/Phoenix")
  currency      String?  @default("usd")

  // --- Integrations (per-org, used from Phase 3 on) -------------------------
  /// Connected Stripe account id (acct_…) for Stripe Connect — the org's own
  /// account that collects their members' fees. Null → falls back to platform.
  stripeAccountId String?
  /// Optional platform application-fee in basis points taken on Connect charges.
  platformFeeBps  Int?
  /// Free-form per-org settings (Zoho list key, feature flags, etc.) as JSON,
  /// so we can add tenant config without a migration each time.
  settings      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// ===========================================================================
// AUTH & IDENTITY
// ===========================================================================

/// A login account. Separate from Person so a household adult can hold one
/// login yet manage several minors, and so staff logins map cleanly to roles.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Primary role: COO | CEO | DIRECTOR | COACH | PLAYER | PARENT  (see enums.ts)
  role         String   @default("PLAYER")
  /// Additional roles held alongside the primary one (e.g. an admin who also
  /// coaches, a parent who also coaches). Effective access is the union; the
  /// primary `role` is the highest-priority of the set. See enums.effectiveRoles.
  extraRoles   String[] @default([])
  personId     String?  @unique
  person       Person?  @relation(fields: [personId], references: [id])
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  // Brute-force protection: lock the account for a cool-down after repeated fails.
  failedLoginCount Int   @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentMessages Message[] @relation("MessageSender")
  auditEvents  AuditLog[]
  resetTokens  PasswordResetToken[]
}

// Self-service password reset (§17/§18). We store only a SHA-256 hash of the
// token; the raw token lives only in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ===========================================================================
// CORE DATA MODEL (spec §2)
// ===========================================================================

/// One record per human, regardless of role (§2). A player-coach is ONE
/// person, not two. Roles are contextual via the linked Coach / Registration /
/// Team-membership records rather than duplicated Person rows.
model Person {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  dob                DateTime?
  email              String?
  /// Additional notification addresses (up to three total). Used so both parents
  /// AND a minor who has their own email can all be reached. For a minor, the
  /// parent/guardian email captured on the waiver is always stored among these.
  /// Each address carries an optional label (a person's name / relationship,
  /// e.g. "Mom", "Dad", the player) so the sender can pick, per email, exactly
  /// who receives it — a progress report to the parents but not an 8-year-old,
  /// a payment reminder to just the paying parent, and so on.
  email2             String?
  email3             String?
  emailLabel         String?
  email2Label        String?
  email3Label        String?
  phone              String?

  /// Public profile image (used on /coaches). Stored in object storage; this is
  /// the served URL. Coaches upload their own; admins can upload on their behalf.
  imageUrl           String?

  // Contact / demographics (captured from enrollment intake)
  address            String?
  gender             String?
  howHeard           String?
  /// Stripe customer id carried over from the source enrollment system
  stripeCustomerId   String?

  // Emergency contact
  emergencyName      String?
  emergencyPhone     String?
  emergencyRelation  String?

  // DUPR (Dynamic Universal Pickleball Rating)
  duprId             String?
  duprRating         Float?
  duprVerified       Boolean   @default(false)
  duprVerifiedAt     DateTime?
  /// Under-18s need parental consent captured WITH the waiver, not in October (§12)
  duprParentalConsent Boolean  @default(false)

  // Waiver / media (§3). Media consent is opt-OUT by written notice; a withheld
  // consent must be recorded and honored against the person record.
  waiverSignedAt     DateTime?
  mediaOptOut        Boolean   @default(false)
  /// Express opt-in to receive email / SMS from PURE (TCPA / Twilio A2P). Set
  /// when the person checks the box on the opt-in form or during registration;
  /// the exact language and timestamp are also captured in MessagingConsent.
  emailConsentAt     DateTime?
  smsConsentAt       DateTime?
  /// Set when this contact was last successfully synced to the Zoho Campaigns
  /// mailing list. Lets the backfill resume without re-pushing everyone.
  zohoSyncedAt       DateTime?
  /// Set when a minor turns 18 and their parent-signed waiver must be replaced
  /// by an adult self-signed waiver. Cleared when they sign the new one.
  waiverRenewalRequiredAt DateTime?

  // Minor handling (§17 — records may contain minors' data)
  isMinor            Boolean   @default(false)
  guardianId         String?
  guardian           Person?   @relation("Guardianship", fields: [guardianId], references: [id])
  dependents         Person[]  @relation("Guardianship")

  medicalNotes       String?   // encrypted-at-rest in production

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User?
  coach              Coach?
  registrations      Registration[]
  waivers            Waiver[]
  teamMemberships    TeamMember[]
  teamContactFor     Team[]           @relation("TeamContact")
  attendance         Attendance[]
  paymentsMade       Payment[]        @relation("PaymentParty")
  availability       AvailabilityConfirmation[]
  pairingsAsA        Pairing[]        @relation("PairingPlayerA")
  pairingsAsB        Pairing[]        @relation("PairingPlayerB")
  messageReceipts    MessageRecipient[]
  conversationsCreated Conversation[]            @relation("ConversationCreator")
  conversationParts    ConversationParticipant[]
  chatMessages         ChatMessage[]             @relation("ChatMessageSender")
  alaCarteBookings   AlaCarteBooking[] @relation("AlaCarteClient")
  coachingNotes      CoachingNote[]
  recruitedByCoachId String?
  recruitedByCoach   Coach?           @relation("CoachRecruits", fields: [recruitedByCoachId], references: [id])

  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
}

/// A person's request to join — capturing a SINGLE division (§3). Distinct from
/// a team assignment. A player between bands is placed by the Director after the
/// Week-1 assessment, not by selecting two divisions.
model Registration {
  id                 String   @id @default(cuid())
  personId           String
  person             Person   @relation(fields: [personId], references: [id])
  seasonId           String
  season             Season   @relation(fields: [seasonId], references: [id])

  divisionId         String?
  division           Division? @relation(fields: [divisionId], references: [id])
  skillLevel         String?
  /// Program interest chosen on the public form (e.g. "High School", "Men's — 3.5")
  /// preserved verbatim so staff see the requested track even when no division matched.
  programInterest    String?
  duprRatingAtReg    Float?

  practiceTimePref   String?   // e.g. "weeknight", "weekend"
  daysThatDontWork   String?   // JSON array of weekday strings
  partnerRequests    String?   // free text / names
  medicalDisclosures String?
  mediaOptOut        Boolean   @default(false)

  // Enrollment intake fields (captured from the source CSV)
  schedule           String?   // chosen schedule text from the enrollment form
  minorNames         String?   // "Minor Name(s)" for household/child registrations
  perClassRateCents  Int?      // per-class rate at enrollment
  enrollmentFeeCents Int?      // enrollment fee at enrollment
  stripeSubscriptionId String? // Stripe subscription id from the source system
  stripePaymentMethod String?  // Stripe payment method from the source system
  sourceStatus       String?   // "Status" from the source system (e.g. active)
  /// Full original enrollment row, so no source field is ever lost
  importRaw          Json?

  /// Coach fee is waived; a coach registers through the same flow (§3)
  isCoachRegistration Boolean  @default(false)
  feeWaived          Boolean   @default(false)

  /// Recruitment attribution — which coach this registration came through (§5)
  recruitedByCoachId String?
  recruitedByCoach   Coach?    @relation(fields: [recruitedByCoachId], references: [id])

  /// Status: SUBMITTED | DUPLICATE | MERGED | ASSIGNED | WAITLISTED | WITHDRAWN
  status             String    @default("SUBMITTED")
  /// Duplicate detection (§3): points at the surviving record after a merge
  mergedIntoId       String?

  locationPrefs      LocationPreference[]

  submittedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([seasonId, divisionId, status])
  @@index([personId])
}

/// Ranked location preference rows for a registration (§3 — "ranked location
/// preferences"). Modeled as rows so ranking is queryable and reportable.
model LocationPreference {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  marketName     String?
  rank           Int

  @@index([registrationId, rank])
}

/// A team (§2). Complete only when all SIX fields are set: division, level band,
/// market, coach, facility, day, time. Cap 8 / minimum 6.
/// IMPORTANT (§12, §14): a coach is NOT required. Outside ACP teams are run by a
/// captain/organizer with no coach. Permissions attach to the team-contact role.
model Team {
  id            String    @id @default(cuid())
  name          String
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id])

  /// Non-production / test team. Kept out of pickers, counts, and public pages
  /// so a rehearsal team can't be mis-selected in production. Marked from the
  /// Teams page; the season it lives in may also be flagged test.
  isTest        Boolean   @default(false)

  divisionId    String?
  division      Division? @relation(fields: [divisionId], references: [id])
  levelBand     String?
  market        String?

  /// Nullable by design — outside teams have no coach (§14)
  coachId       String?
  coach         Coach?    @relation("TeamCoach", fields: [coachId], references: [id])
  /// The person who holds the roster, submits line-ups, confirms availability,
  /// answers reschedule requests. For a PURE team this is the coach; for an
  /// outside team, a captain/organizer (§14 "Team contact").
  teamContactId String?
  teamContact   Person?   @relation("TeamContact", fields: [teamContactId], references: [id])

  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id])
  dayOfWeek     String?   // MON..SUN
  startTime     String?   // "HH:MM"

  /// True where the coach plays on the team they coach (§2, §4). A player-coach
  /// keeps their own team; no second coach is assigned to it.
  coachPlays    Boolean   @default(false)

  /// Set when the team is "launched" — the combined welcome + apparel/pay (+
  /// waiver) email has gone out to the roster's families. Drives the
  /// Launched / Ready to launch status shown on the Teams page. A re-launch
  /// refreshes it; it stays set once launched.
  launchedAt    DateTime?

  /// Origin — must NOT assume a team belongs to PURE Academy (§12)
  /// PURE_ACADEMY | ACP_CLUB
  origin        String    @default("PURE_ACADEMY")
  clubName      String?   // for outside ACP clubs

  /// Identity stored as separate parts; the display name is ALWAYS rendered from
  /// these via teamDisplayName() — never a concatenated stored string — so a
  /// change to any part propagates everywhere at once (build-list §6).
  ///   club         — "PURE" for Academy teams; the club name for outside teams
  ///   market       — Scottsdale · Mesa · Gilbert · Chandler · Tempe · Phoenix ·
  ///                  Paradise Valley (nullable; optional for outside clubs)
  ///   divisionCode — ELE | MID | HS | W2.5..W5.0+ | M2.5..M5.0+ (no "ELITE")
  ///   color        — Blue|Green|Red|Yellow|Orange|Purple, only when a market
  ///                  fields 2+ teams in a division; assigned in palette order
  club          String    @default("PURE")
  divisionCode  String?
  /// Team gender: MALE | FEMALE | COED. For adults it's implied by the division
  /// code (M/W) but stored here too when set; it's the ONLY place youth gender
  /// lives (e.g. High School Boys vs Girls), since the youth codes ELE/MID/HS
  /// don't carry it. Null = unspecified (treated as coed).
  gender        String?
  color         String?

  /// Optional team photo (object-storage URL). Shown on the public team page
  /// ONLY when every rostered player has media consent (Community Layer §3.5) —
  /// where any player is missing consent the photo is withheld, never cropped.
  photoUrl      String?

  /// Team cannot be published to families until the facility agreement is
  /// executed (§4 publication gate).
  published     Boolean   @default(false)
  publishedAt   DateTime?

  forfeitCount  Int       @default(0)
  /// Championship eligibility; two forfeits ends it (§12). Restorable only by
  /// joint Director+COO override, recorded explicitly.
  champEligible Boolean   @default(true)
  eligibilityOverrideById String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       TeamMember[]
  homeFixtures  Fixture[] @relation("HomeTeam")
  awayFixtures  Fixture[] @relation("AwayTeam")
  pairings      Pairing[]
  sessions      SessionTeam[]
  assistantCoaches TeamCoach[]
  leagueEntries LeagueTeam[]
  coachingNotes CoachingNote[]

  @@index([seasonId, divisionId])
  @@index([coachId])
  @@index([club, market, divisionCode])
}

/// Additional coaches on a team beyond the head coach (Team.coachId). A team may
/// carry a 2nd/3rd coach or assistant; a single-class substitute is modeled at
/// the session level (SessionCoach) instead. role: ASSISTANT | ADDITIONAL.
model TeamCoach {
  id        String @id @default(cuid())
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coachId   String
  coach     Coach  @relation("TeamAssistantCoach", fields: [coachId], references: [id])
  role      String @default("ASSISTANT")
  createdAt DateTime @default(now())

  @@unique([teamId, coachId])
  @@index([coachId])
}

/// Roster row linking a Person to a Team (many-to-many with attributes).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  /// PLAYER | COACH_PLAYER | ASSISTANT | CAPTAIN
  roleOnTeam String  @default("PLAYER")
  joinedAt  DateTime @default(now())

  @@unique([teamId, personId])
  @@index([personId])
}

/// Weekly coaching note / progress report for one student on a team. Up to six
/// one-week sections per (team, student). `strengths` and `growth` hold JSON
/// string arrays of preset tag ids (see domain/coachingNotes) the student
/// excelled at / needs to work on; `note` is free text the coach can customize.
/// `sentToParentAt` records the last time this week's report was emailed to the
/// parent/guardian, so the roster can show what's been shared.
model CoachingNote {
  id             String    @id @default(cuid())
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId       String
  person         Person    @relation(fields: [personId], references: [id])
  week           Int
  strengths      String    @default("[]")
  growth         String    @default("[]")
  note           String?
  /// User id of the coach/admin who last edited this note.
  authorId       String?
  sentToParentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([teamId, personId, week])
  @@index([personId])
  @@index([teamId])
}

/// Coach profile (§5). One-to-one with a Person.
model Coach {
  id                  String    @id @default(cuid())
  personId            String    @unique
  person              Person    @relation(fields: [personId], references: [id])

  rpoCertLevel        String?
  /// Self-service coach profile (§5). certifications = credentials/cert text;
  /// bio = coaching history/background; coachingLevels = which levels/ages they
  /// can coach (e.g. "2.5–4.0, Youth, High School"). Location availability lives
  /// in marketsCovered; day/time availability in AvailabilityBlock; contact on Person.
  certifications      String?
  bio                 String?
  coachingLevels      String?
  /// Hard gate (§5): no team assignment without a completed background check…
  backgroundCheckDate DateTime?
  backgroundCheckExpiry DateTime?
  /// …and curriculum onboarding
  onboardingCompletedAt DateTime?
  /// Safe Sport certification + background-check provider (screening detail).
  safeSportCertified  Boolean @default(false)
  backgroundCheckCompany String?

  marketsCovered      String?   // JSON array
  /// Pro Coach / Assistant differentiate payout rate (§9)
  isProCoach          Boolean   @default(false)

  /// Show this coach on the public /coaches page. Off by default — publish only
  /// coaches confirmed for the season, not the full prospective roster (§ build
  /// list item 2).
  publishedOnSite     Boolean   @default(false)
  /// Field keys the coach/admin has chosen to HIDE from the public profile
  /// (empty = everything shows). Keys: bio | credentials | markets | levels.
  /// Name and photo are always public once publishedOnSite. See domain/coachPublic.
  publicHidden        String[]  @default([])

  /// Secret token for the coach's personal calendar subscription feed
  /// (/api/calendar/<token>) — a URL they add to their phone's calendar so
  /// their practices, matches, and lessons stay in sync automatically.
  calendarToken       String?   @unique

  /// Compensation (§9) — admin-only. A rate and/or a percentage per work type:
  /// regular-season coaching, private/semi-private lessons, and clinics. Rates
  /// stored in cents; percentages as whole numbers (e.g. 60 = 60%). payNotes
  /// captures the "etc." (per-hour vs per-session, tiers, guarantees).
  seasonPayCents      Int?
  seasonPayPct        Int?
  lessonPayCents      Int?
  lessonPayPct        Int?
  clinicPayCents      Int?
  clinicPayPct        Int?
  payNotes            String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  teams               Team[]         @relation("TeamCoach")
  assistantTeams      TeamCoach[]    @relation("TeamAssistantCoach")
  availabilityBlocks  AvailabilityBlock[]
  recruits            Person[]       @relation("CoachRecruits")
  recruitedRegs       Registration[]
  payouts             CoachPayoutLine[]
  alaCarteOfferings   AlaCarteOffering[]
  alaCarteBookings    AlaCarteBooking[] @relation("AlaCarteCoach")
}

/// Coach availability by day + time block (§5), matched against facility court
/// blocks before a team's day/time is published.
model AvailabilityBlock {
  id        String @id @default(cuid())
  coachId   String
  coach     Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek String // MON..SUN
  startTime String // "HH:MM"
  endTime   String

  @@index([coachId])
}

/// Facility & court inventory (§6).
model Facility {
  id               String    @id @default(cuid())
  name             String
  market           String?
  courtCount       Int       @default(0)

  /// Agreement status: IDENTIFIED | VERBAL | AGREEMENT_SENT | EXECUTED (§6)
  agreementStatus  String    @default("IDENTIFIED")

  /// Fee basis: NONE | PER_COURT | PER_HOUR | PER_SESSION | PERCENTAGE (§2/§6)
  feeBasis         String    @default("NONE")
  weekdayRateCents Int       @default(0)
  weekendRateCents Int       @default(0)
  percentageRate   Float?    // for PERCENTAGE basis (on On-Site Practice Revenue)
  paymentTerms     String?

  primaryContact   String?
  contactEmail     String?
  contactPhone     String?

  /// Access instructions and exact location live behind login only (§15). A
  /// private residence/court appears publicly by market + general area only —
  /// never owner name, never street address.
  isPrivate        Boolean   @default(false)
  generalArea      String?   // public-safe descriptor, e.g. "North Scottsdale"
  exactAddress     String?   // behind login, released to assigned players only
  accessInstructions String?

  /// Court lighting: "" / null = unspecified, LIGHTS = playable after dark,
  /// NO_LIGHTS = daylight only. Drives evening scheduling decisions.
  lights           String?

  /// Free-form operational notes about the venue — where to park, how to get in,
  /// gate codes context, house rules, anything staff and coaches should know.
  notes            String?

  /// À la carte eligibility must be negotiated per agreement, not assumed (§11)
  alaCarteAllowed  Boolean   @default(false)

  /// ACP league option (§6): held courts, confirm-by date, auto-release
  acpLeagueOption  Boolean   @default(false)
  acpHeldCourts    Int?
  acpConfirmBy     DateTime?
  championshipHostInterest Boolean @default(false)

  /// Retired from selection. Archived facilities keep all history but no longer
  /// appear in scheduling / team-build dropdowns. Used instead of deletion when
  /// a facility is referenced by past teams or sessions.
  archived         Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  courtBlocks      CourtBlock[]
  blackoutDates    BlackoutDate[]
  sessions         Session[]
  teams            Team[]
  fixtures         Fixture[]
  locationPrefs    LocationPreference[]
  statements       FacilityStatement[]
  alaCarteOfferings AlaCarteOffering[]

  @@index([market])
  @@index([agreementStatus])
}

/// A bookable block of courts at a facility. Cannot be published against a
/// non-executed agreement without explicit override (§6).
model CourtBlock {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dayOfWeek    String
  startTime    String
  endTime      String
  courtCount   Int      @default(1)
  overrideNonExecuted Boolean @default(false)
  /// AVAILABLE (open for booking, default) or BLOCKED (recurring unavailable
  /// window — the courts are dark/committed then). A BLOCKED window excludes a
  /// day/time even if it also falls inside an AVAILABLE one.
  kind         String   @default("AVAILABLE")

  @@index([facilityId])
}

/// Blackout dates enforced against a facility (§6). Thanksgiving week Nov 23–29
/// is dark: no practices, no league matches, no rescheduled fixtures.
model BlackoutDate {
  id         String   @id @default(cuid())
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Global blackout when facilityId is null (e.g. Thanksgiving week for all)
  date       DateTime
  reason     String?

  @@index([date])
}

/// The atomic scheduling unit (§2). Every court charge and every coach payment
/// derives from a session record.
model Session {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id])

  /// Type: PRACTICE | LEAGUE_MATCH | CHAMPIONSHIP | ALA_CARTE (§2)
  type         String
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  date         DateTime
  startTime    String
  endTime      String
  courtCount   Int      @default(1)

  /// Status: SCHEDULED | DELIVERED | CANCELLED | RESCHEDULED (§2)
  status       String   @default("SCHEDULED")
  /// Cancellation reason: HEAT | WEATHER | FACILITY_CLOSURE | SAFETY | OTHER (§7)
  cancelReason String?
  /// Relocation to indoor court preserves the session as delivered (§7)
  relocatedFacilityId String?

  weekNumber   Int?     // 1..12 within the team's season plan

  /// When the ~15-minutes-before check-in reminder text was sent to the
  /// coach(es), so the reminder cron never double-sends.
  checkinReminderSentAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams        SessionTeam[]
  coaches      SessionCoach[]
  attendance   Attendance[]
  payments     Payment[]
  fixture      Fixture?

  @@index([seasonId, date])
  @@index([status])
}

model SessionTeam {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([sessionId, teamId])
}

/// Coach on a session — supports substitute/backup coverage per session (§5)
/// and assistant-coach payout at 50% (§9).
model SessionCoach {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coachId   String
  /// PRIMARY | ASSISTANT | SUBSTITUTE | BACKUP
  role      String  @default("PRIMARY")
  /// Whether this coach is paid for a session PURE cancels — modeled as a
  /// per-session payable flag so policy can flip without rework (§9).
  paidIfCancelled Boolean @default(false)

  @@unique([sessionId, coachId])
  @@index([coachId])
}

/// Attendance per session, per player, marked by the coach (§7).
model Attendance {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id])
  /// PRESENT | ABSENT | EXCUSED
  status    String  @default("PRESENT")
  markedAt  DateTime @default(now())

  @@unique([sessionId, personId])
}

// ===========================================================================
// PAYMENTS (spec §8, §9, §10)
// ===========================================================================

/// Direction in/out (§2). Never stores card data — Stripe hosted checkout only.
model Payment {
  id            String   @id @default(cuid())
  /// IN | OUT
  direction     String
  partyId       String?
  party         Person?  @relation("PaymentParty", fields: [partyId], references: [id])

  amountCents   Int
  /// Method: STRIPE | CHECK | ACH | IN_KIND | CREDIT
  method        String   @default("STRIPE")
  /// Status: REQUESTED | PENDING | PAID | FAILED | REFUNDED | WAIVED | CREDITED
  status        String   @default("REQUESTED")

  /// PLAYER_FEE | COACH_PAYOUT | FACILITY_FEE | ALA_CARTE | REFUND
  category      String

  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id])
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])

  // Stripe references — never raw card data (§18)
  stripeCheckoutId String?
  stripePaymentIntentId String?
  stripeSubscriptionId String?

  /// Monthly-vs-full for player fees (§8). installmentPlan = true means the
  /// 3-payment plan; installmentsPaid/Total track how many of the 3 have cleared.
  installmentPlan Boolean @default(false)
  installmentsPaid Int    @default(0)
  installmentsTotal Int?

  /// For a consolidated family season-fee invoice: the player personIds this one
  /// payment covers (partyId is the paying adult). Null on legacy single-player
  /// payments, which implicitly cover just their partyId.
  coveredPersonIds Json?

  description   String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Team apparel bought alongside this payment (season fee). Bundled into the
  /// same Stripe checkout as one-time line items.
  apparelItems  ApparelOrderItem[]

  @@index([direction, category, status])
  @@index([partyId])
}

/// A line of team apparel a player buys with their season fee — required for
/// team-assigned players. Bundled into the season-fee checkout; these rows are
/// the fulfillment record (what to print/order and for whom).
model ApparelOrderItem {
  id           String  @id @default(cuid())
  paymentId    String
  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// Which player it's for (optional; the paying adult may buy for several kids).
  personId     String?
  /// SHIRT | TANK
  garment      String
  /// Size key — YS..YXL (youth), AXS..A2XL (adult). See lib/domain/apparel.
  size         String
  quantity     Int     @default(1)
  unitPriceCents Int
  /// FULFILLMENT: PENDING | ORDERED | DELIVERED
  fulfillment  String  @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([paymentId])
}

/// Configurable rate sets (§0, §9, §11). Both the coach-teaches and
/// director-teaches à-la-carte splits live here; the applied rates are STAMPED
/// onto each transaction so historical payouts survive a rate change.
model RateConfig {
  id                String   @id @default(cuid())
  seasonId          String?
  /// Player season fee (§8) — default $495
  seasonFeeCents    Int      @default(49500)
  /// Coach per-session pay (§9) — default $100, $1,200 across 12 sessions
  coachPerSessionCents Int   @default(10000)
  assistantPct      Float    @default(0.5)
  proCoachPerSessionCents Int?

  /// Team apparel prices — every team-assigned player buys at least one item
  /// (T-shirt or tank top) bundled with their season fee. Editable in settings.
  shirtPriceCents   Int      @default(2500)
  tankPriceCents    Int      @default(2500)

  // À la carte split (§0, §11) — court cost off the top, then split net
  alaCoachSharePct     Float @default(0.5)  // assigned coach teaches
  alaDirectorSharePct  Float @default(0.1)
  alaPurePct           Float @default(0.4)
  // Director-teaches variant: coach line moves to director (70% total), PURE 30%
  alaDirCoachSharePct  Float @default(0.6)
  alaDirDirectorSharePct Float @default(0.1)
  alaDirPurePct        Float @default(0.3)

  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())
}

/// A payout run per coach per period (§9): sessions delivered, à la carte
/// earnings, total. Exportable for the payment rail.
model PayoutRun {
  id          String   @id @default(cuid())
  seasonId    String?
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("DRAFT") // DRAFT | FINALIZED | EXPORTED | PAID
  createdAt   DateTime @default(now())

  lines       CoachPayoutLine[]
}

model CoachPayoutLine {
  id             String    @id @default(cuid())
  payoutRunId    String
  payoutRun      PayoutRun @relation(fields: [payoutRunId], references: [id], onDelete: Cascade)
  coachId        String
  coach          Coach     @relation(fields: [coachId], references: [id])
  sessionsDelivered Int    @default(0)
  sessionPayCents   Int    @default(0)
  alaCarteCents     Int    @default(0)
  totalCents        Int    @default(0)

  @@index([coachId])
}

/// One statement per facility per month (§10) — a contractual obligation.
model FacilityStatement {
  id             String   @id @default(cuid())
  facilityId     String
  facility       Facility @relation(fields: [facilityId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  sessionsDelivered Int   @default(0)
  /// Revenue on which a percentage payment is calculated — On-Site Practice
  /// Revenue only, net of refunds and processing charges (§10).
  onSiteRevenueCents Int  @default(0)
  amountDueCents Int      @default(0)
  status         String   @default("DRAFT") // DRAFT | ISSUED | PAID
  createdAt      DateTime @default(now())

  @@index([facilityId, periodStart])
}

// ===========================================================================
// SEASON / DIVISION / LEAGUE (spec §12–§14)
// ===========================================================================

model Season {
  id         String   @id @default(cuid())
  name       String
  /// PURE_ACADEMY | ACP
  program    String   @default("PURE_ACADEMY")
  startDate  DateTime
  endDate    DateTime
  opensOn    DateTime?
  /// Optional registration-close date. After this, the public form stops
  /// accepting new signups (null = open until the season is deactivated).
  closesOn   DateTime?
  /// When the year-end championship tournament begins (one event; individual
  /// bracket matches aren't separately scheduled).
  championshipStartsAt DateTime?
  active     Boolean  @default(true)
  /// Non-production / test season. Excluded from public pages (standings,
  /// league, championship) and from being picked as the live season, but still
  /// visible and usable in the console so staff can rehearse a setup safely.
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())

  /// Editable season arc. Auto-filled from the standard 12-week template the
  /// first time it's initialized, then editable per week (dates, focus,
  /// milestone). Null = show the standard template read-only.
  calendar   Json?

  divisions     Division[]
  teams         Team[]
  registrations Registration[]
  sessions      Session[]
  payments      Payment[]
  fixtures      Fixture[]
  messages      Message[]
  leagueTeams   LeagueTeam[]
}

/// A stored record of express consent to receive email / SMS messages — the
/// auditable proof of opt-in for TCPA and Twilio A2P 10DLC (who, when, what
/// language, what channels, from where). Every submission of the /opt-in form
/// and every consenting registration writes one.
model MessagingConsent {
  id             String   @id @default(cuid())
  personId       String?
  name           String
  email          String?
  phone          String?
  emailOptIn     Boolean  @default(false)
  smsOptIn       Boolean  @default(false)
  /// The exact consent language shown to the person, and its version.
  consentText    String
  consentVersion String
  /// Where the consent came from: opt-in-form | registration.
  source         String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([phone])
}

/// Phase-B ACP entry from an outside club (build-list item 1). One team entered
/// into one division, with its roster and the $195-per-player fee. The team
/// contact (a captain/organizer, not a coach) holds the entry.
model AcpEntry {
  id            String   @id @default(cuid())
  /// Scalar season link (no FK) — the active ACP season at entry time.
  seasonId      String?
  clubName      String
  market        String?
  /// What the club typed for their division, plus the code we derived from it.
  divisionName  String
  divisionCode  String?
  contactName   String
  contactEmail  String
  contactPhone  String?
  playerCount   Int
  amountDueCents Int
  /// SUBMITTED | CONFIRMED | PAID | WITHDRAWN
  status        String   @default("SUBMITTED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players       AcpEntryPlayer[]

  @@index([createdAt])
  @@index([status])
}

/// A rostered player on an ACP entry. DUPR is required for adult divisions and
/// validated against the band ceiling at submission (see domain/acpEntry.ts).
model AcpEntryPlayer {
  id         String   @id @default(cuid())
  entryId    String
  entry      AcpEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  duprId     String?
  duprRating Float?
  createdAt  DateTime @default(now())

  @@index([entryId])
}

/// Phase-A interest from an outside club before ACP entries open (Sep 14). Just
/// enough to email them when entries open and to gauge how many teams a thin
/// division might get (build-list item 1).
model AcpInterest {
  id              String   @id @default(cuid())
  clubName        String
  contactName     String
  email           String
  phone           String?
  market          String?
  likelyTeams     Int?
  likelyDivisions String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// A ladder competition (§14, event types). Entries are ranked by position;
/// winning a challenge against a higher-ranked entry swaps the two positions.
model Ladder {
  id        String        @id @default(cuid())
  name      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  entries   LadderEntry[]
}

model LadderEntry {
  id        String   @id @default(cuid())
  ladderId  String
  ladder    Ladder   @relation(fields: [ladderId], references: [id], onDelete: Cascade)
  /// Optional link to a Team; otherwise a free-text name (a player or pair).
  teamId    String?
  name      String
  position  Int
  wins      Int      @default(0)
  losses    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ladderId, position])
}

/// Public request for a private lesson, semi-private, or clinic (no account
/// needed). Captured from /clinics/request, emailed to the ops inbox, and worked
/// from the console. requestType: PRIVATE | SEMI_PRIVATE | CLINIC | UNSURE.
model LessonRequest {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  requestType    String   @default("UNSURE")
  skillLevel     String?
  locations      String?
  preferredTimes String?
  notes          String?
  /// NEW | CONTACTED | SCHEDULED | CLOSED
  status         String   @default("NEW")
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

/// Explicit league membership — which teams play in a season's league. Decouples
/// the league roster from a team's own season/division so any published team can
/// be added to the active ACP league, regardless of the season it was built in.
/// The league leaderboard and round-robin are computed over these entries.
model LeagueTeam {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([teamId])
}

/// Divisions by school level (youth) or DUPR band (adults). Bands lock at
/// Week 2 (§12) — placement holds through Championship regardless of mid-season
/// rating movement.
model Division {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  name        String
  /// SCHOOL_LEVEL | DUPR_BAND
  divisionType String  @default("DUPR_BAND")
  minRating   Float?
  maxRating   Float?
  bandsLocked Boolean  @default(false)
  bandsLockedAt DateTime?

  teams         Team[]
  registrations Registration[]

  @@index([seasonId])
}

/// A league fixture between two teams (§14). Team references are nullable-safe
/// for byes; hub venue + court allocation captured for match-night ops.
model Fixture {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  weekNumber  Int
  scheduledAt DateTime
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  courtAllocation String?
  arrivalInstructions String?

  homeTeamId  String?
  homeTeam    Team?    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String?
  awayTeam    Team?    @relation("AwayTeam", fields: [awayTeamId], references: [id])

  /// Status: SCHEDULED | CONFIRMED | RESCHEDULED | FORFEITED | COMPLETED (§14)
  status      String   @default("SCHEDULED")
  /// Which team forfeited (if any). Forfeits recorded 3–0, NEVER submitted to
  /// DUPR (§12) — the submission pipeline excludes them by rule.
  forfeitedById String?

  /// Match format: TEAM_3 (three counting lines + exhibition, default), TEAM_5
  /// (five counting lines), or SINGLE_LINE (one line). Drives how many lines the
  /// score sheet renders and which lines count toward standings.
  matchType   String   @default("TEAM_3")

  /// Scoring rules for each line's games — a composable format so round-robin
  /// matches (e.g. one game to 11) and playoff matches (best 2 of 3 to 11) can
  /// differ per fixture. serveType: SIDE_OUT | RALLY. gamesToWin: 1 (single
  /// game), 2 (best 2 of 3), 3 (best 3 of 5). freezeAt: rally-scoring freeze
  /// threshold (null = none).
  serveType   String   @default("SIDE_OUT")
  pointsTo    Int      @default(11)
  winByTwo    Boolean  @default(true)
  freezeAt    Int?
  gamesToWin  Int      @default(2)

  /// Score-acceptance workflow. NONE → a team PROPOSED scores → the opposing team
  /// ACCEPTED (final) or DISPUTED (back to open). An admin can enter/override at
  /// any time, which lands ACCEPTED directly. scoreProposedById is the team that
  /// entered the pending scores; scoreNote carries a dispute reason.
  scoreStatus       String    @default("NONE")
  scoreProposedById String?
  scoreProposedAt   DateTime?
  scoreAcceptedAt   DateTime?
  scoreNote         String?

  /// Optional link to the underlying Session (court booking moves with the
  /// fixture on an accepted reschedule).
  sessionId   String?  @unique
  session     Session? @relation(fields: [sessionId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines        LineMatchup[]
  confirmations AvailabilityConfirmation[]
  rescheduleRequests RescheduleRequest[]
  duprSubmission DuprSubmission?

  @@index([seasonId, weekNumber])
  @@index([status])
}

/// A line matchup within a fixture (§12). Line 1 v 1, 2 v 2, 3 v 3; a 4th line
/// where a team carries 8 is EXHIBITION — recorded in full but non-counting.
model LineMatchup {
  id          String   @id @default(cuid())
  fixtureId   String
  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  lineNumber  Int      // order within the fixture (1..N)
  /// A line flagged non-counting (e.g. an exhibition) is recorded but excluded
  /// from the match result and standings.
  isCounting  Boolean  @default(true)
  homePairingId String?
  awayPairingId String?
  /// HOME | AWAY | null — computed from games (2 of 3)
  lineWinner  String?

  /// A club match is a stack of categorized lines: Men's #1, Women's #1, Youth
  /// Boys #1, etc. category is MENS | WOMENS | MIXED | YOUTH_BOYS | YOUTH_GIRLS
  /// | OPEN; rank is the #1/#2 within that category; label is an optional
  /// override. The two players each side fields are stored by id and resolved to
  /// names from the team rosters.
  category    String   @default("OPEN")
  rank        Int      @default(1)
  label       String?
  homePlayer1Id String?
  homePlayer2Id String?
  awayPlayer1Id String?
  awayPlayer2Id String?

  games       GameScore[]

  @@unique([fixtureId, lineNumber])
}

/// Individual game score per line (§12). "The data model must store individual
/// game scores per line" — best of three to 11, win by 2, switch ends at 6 in G3.
model GameScore {
  id           String @id @default(cuid())
  lineId       String
  line         LineMatchup @relation(fields: [lineId], references: [id], onDelete: Cascade)
  gameNumber   Int    // 1..3
  homeScore    Int    @default(0)
  awayScore    Int    @default(0)

  @@unique([lineId, gameNumber])
}

/// A ranked pairing for a team in a given week (§12/§14). Line-ranking history
/// is retained and auditable — holding a strong pair at line 3 distorts ratings.
model Pairing {
  id         String  @id @default(cuid())
  teamId     String
  team       Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weekNumber Int
  rank       Int     // 1..4 (4 = exhibition)
  playerAId  String
  playerA    Person  @relation("PairingPlayerA", fields: [playerAId], references: [id])
  playerBId  String
  playerB    Person  @relation("PairingPlayerB", fields: [playerBId], references: [id])
  /// Combined DUPR — validated for non-PURE teams: line1 > line2 > line3 (§14)
  combinedDupr Float?
  createdAt  DateTime @default(now())

  @@index([teamId, weekNumber])
}

/// Player-entered availability for a fixture (§14). The 48-hour rule: not
/// relayed through a coach. Fuels the escalation alert to coach+Director+COO.
model AvailabilityConfirmation {
  id         String   @id @default(cuid())
  fixtureId  String
  fixture    Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id])
  /// PLAYING | NOT_PLAYING | UNCONFIRMED
  status     String   @default("UNCONFIRMED")
  confirmedAt DateTime?

  @@unique([fixtureId, personId])
}

/// Reschedule request (§14). Blocked by the system inside 7 days. Opposing
/// contact accepts/rejects in-platform; the Director is copied on both.
model RescheduleRequest {
  id            String   @id @default(cuid())
  fixtureId     String
  fixture       Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  requestedByTeamId String
  proposedAt    DateTime
  reason        String?
  /// PENDING | ACCEPTED | REJECTED
  status        String   @default("PENDING")
  respondedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([fixtureId])
}

/// DUPR submission with a retry queue and explicit error state (§12). Forfeited
/// fixtures are excluded by rule — never submitted.
model DuprSubmission {
  id          String   @id @default(cuid())
  fixtureId   String   @unique
  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  /// PENDING | SUBMITTED | REJECTED | EXCLUDED (forfeit/no-play)
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================================================================
// À LA CARTE (spec §11)
// ===========================================================================

/// Player-facing catalog entry (§11). Priced by PURE per venue — coaches do NOT
/// set their own prices. Venue eligibility gated on Facility.alaCarteAllowed.
model AlaCarteOffering {
  id          String   @id @default(cuid())
  /// PRIVATE | SEMI_PRIVATE | CLINIC
  type        String
  title       String
  description String?
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  coachId     String?
  coach       Coach?   @relation(fields: [coachId], references: [id])
  priceCents  Int
  /// Max participants (per-person price). null = uncapped.
  capacity    Int?
  /// When the class/clinic runs.
  scheduledAt DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookings    AlaCarteBooking[]

  @@index([facilityId])
}

/// A booking. Court cost comes off the top, then the split is applied to net;
/// the applied rate set is STAMPED here so historical payouts survive a rate
/// change (§0, §11).
model AlaCarteBooking {
  id            String   @id @default(cuid())
  offeringId    String
  offering      AlaCarteOffering @relation(fields: [offeringId], references: [id])
  clientId      String
  client        Person   @relation("AlaCarteClient", fields: [clientId], references: [id])
  coachId       String?
  coach         Coach?   @relation("AlaCarteCoach", fields: [coachId], references: [id])
  /// Whether the Academy Director taught (resolves which split applies)
  directorTaught Boolean @default(false)
  /// REQUESTED | ACCEPTED | DECLINED | DELIVERED | CANCELLED
  status        String   @default("REQUESTED")

  grossCents    Int      @default(0)
  courtCostCents Int     @default(0)
  netCents      Int      @default(0)
  // Stamped splits (cents)
  coachCents    Int      @default(0)
  directorCents Int      @default(0)
  pureCents     Int      @default(0)
  // Stamped rates for auditability
  appliedCoachPct    Float?
  appliedDirectorPct Float?
  appliedPurePct     Float?

  scheduledAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([coachId])
}

// ===========================================================================
// COMMUNICATIONS (spec §13) — a core capability, not a notification layer.
// ===========================================================================

model Message {
  id          String   @id @default(cuid())
  senderId    String?
  sender      User?    @relation("MessageSender", fields: [senderId], references: [id])
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id])

  /// Audience scope: ALL_PLAYERS | ALL_COACHES | MARKET | DIVISION | TEAM |
  /// SINGLE_COACH | SINGLE_PERSON | OPPOSING_CONTACT (§13)
  audienceType String
  audienceRef  String?  // id of the team/division/market/person as applicable

  /// Channels this message was mirrored to: comma set of IN_APP,EMAIL,SMS (§13)
  channels     String   @default("IN_APP,EMAIL")

  /// Trigger type when system-generated (§13 triggered-message table), else null
  triggerType  String?
  subject      String?
  body         String
  /// Optional branded HTML mirror of the message, so the in-app announcement can
  /// replicate the emailed notification exactly (with its action buttons).
  html         String?

  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  recipients   MessageRecipient[]

  @@index([audienceType, audienceRef])
  @@index([triggerType])
}

/// Per-person delivery record (§13). A message log per person and per team so
/// "we told them" is verifiable; delivery failure is an ERROR state, not a
/// silent drop.
model MessageRecipient {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id])
  /// per-channel delivery: QUEUED | SENT | DELIVERED | FAILED | READ
  inAppStatus String  @default("QUEUED")
  emailStatus String?
  smsStatus   String?
  readAt      DateTime?
  failedReason String?

  @@unique([messageId, personId])
  @@index([personId])
}

// ===========================================================================
// DIRECT MESSAGING — on-platform, retained. Peer-to-peer conversations between
// staff, coaches, and parents. Everything is retained even after a user hides a
// thread or deletes a message, so an Admin can review any exchange.
// ===========================================================================

model Conversation {
  id            String   @id @default(cuid())
  subject       String?
  createdById   String?
  createdBy     Person?  @relation("ConversationCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  /// Bumped on every new message so inboxes sort by recent activity.
  lastMessageAt DateTime @default(now())

  participants  ConversationParticipant[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id])
  lastReadAt     DateTime?
  /// User archived / "deleted" the thread. Hidden from THEM; retained for Admins.
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, personId])
  @@index([personId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Person       @relation("ChatMessageSender", fields: [senderId], references: [id])
  body           String
  /// Soft-delete: hidden from participants, retained for Admin moderation.
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ===========================================================================
// COMPLIANCE & AUDIT (spec §3, §17, §18)
// ===========================================================================

/// Waiver capture with signature date (§3). No player appears on a court-ready
/// roster without one. Records media consent (opt-out honored).
model Waiver {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  seasonId    String?
  signedAt    DateTime
  signatureName String
  mediaConsent Boolean @default(true)
  /// Parental consent captured alongside the participation waiver for minors
  parentalConsent Boolean @default(false)
  documentVersion String?

  @@index([personId])
}

/// A championship bracket match (§14 — championship week Dec 7–13). Teams are
/// seeded from division standings; the bracket is single-elimination and byes
/// auto-advance. Team/division/season references are stored as ids (resolved in
/// app code) to keep the bracket self-contained. Format is deliberately simple —
/// the spec leaves championship format "not yet set … it follows from the number
/// of teams" — so a match records a winner and an optional score.
model ChampionshipMatch {
  id           String   @id @default(cuid())
  seasonId     String
  divisionId   String
  /// Which bracket this match belongs to: W (winners / single-elim default), L
  /// (losers, double-elim only), or GF (grand final). Single-elimination draws
  /// use only W, so existing brackets are unaffected.
  bracket      String   @default("W")
  round        Int      // 1 = first round; increases toward the final
  slot         Int      // position within the round (0-indexed)
  homeTeamId   String?
  awayTeamId   String?
  homeSeed     Int?
  awaySeed     Int?
  winnerTeamId String?
  homeScore    Int?
  awayScore    Int?
  /// PENDING | READY | COMPLETED | BYE
  status       String   @default("PENDING")
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([seasonId, divisionId, bracket, round, slot])
  @@index([seasonId, divisionId])
}

/// Audit trail on assignments, cancellations, waivers, and payments (§18).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  entityType String   // Team | Session | Waiver | Payment | Registration ...
  entityId   String
  action     String   // CREATE | UPDATE | ASSIGN | CANCEL | OVERRIDE | ...
  summary    String?
  metadata   String?  // JSON before/after
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ===========================================================================
// SPONSORSHIPS
// ===========================================================================
// Sell sponsorships at three levels — a whole LEAGUE, a TOURNAMENT, or an
// individual TEAM (ORG-wide is also available). A league organizer sells at the
// league level; each team can independently source and secure its own sponsors.
// The "ways a sponsor gets value" are a fully customizable catalog (SponsorBenefit)
// — every entry can be renamed, deactivated, or added to; nothing is hardcoded.
// Scope is polymorphic (scopeType + scopeId) to fit this codebase's Season-as-
// league / Season-as-tournament / Team model without brittle cross-FKs:
//   LEAGUE / TOURNAMENT → scopeId is a Season id
//   TEAM                → scopeId is a Team id
//   ORG                 → scopeId is null (applies to the whole organization)
// organizationId scopes every row to its tenant (Phase 2 enforces this globally).

/// A customizable "way a sponsor gets value" — the catalog an org edits freely
/// (rename, deactivate, add). Packages pick from these; none of it is fixed.
model SponsorBenefit {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  description    String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packageLinks   SponsorshipPackageBenefit[]

  @@index([organizationId, active])
}

/// A sponsoring company or individual (reusable across levels and seasons).
model Sponsor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  logoUrl        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sponsorships   Sponsorship[]

  @@index([organizationId])
}

/// A sellable sponsorship package/tier at a level. scopeId null = a reusable
/// template for that scope type (e.g. a default "Gold" any team can offer); set
/// scopeId to bind a package to one specific league/tournament/team.
model SponsorshipPackage {
  id             String   @id @default(cuid())
  organizationId String
  /// LEAGUE | TOURNAMENT | TEAM | ORG
  scopeType      String
  /// Season id (LEAGUE/TOURNAMENT), Team id (TEAM), or null (ORG / template).
  scopeId        String?
  name           String
  description    String?
  priceCents     Int      @default(0)
  /// Optional cap on how many of this package can be sold (null = unlimited).
  inventory      Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  benefitLinks   SponsorshipPackageBenefit[]
  sponsorships   Sponsorship[]

  @@index([organizationId, scopeType, scopeId])
}

/// Which benefits a package includes (join between package and benefit catalog).
model SponsorshipPackageBenefit {
  id         String   @id @default(cuid())
  packageId  String
  package    SponsorshipPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  benefitId  String
  benefit    SponsorBenefit     @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([packageId, benefitId])
  @@index([benefitId])
}

/// A secured or in-progress sponsorship deal at a scope. A team coach sourcing
/// their own team sponsor and an admin selling a league title sponsor both land
/// here, distinguished by scopeType/scopeId and securedById.
model Sponsorship {
  id             String   @id @default(cuid())
  organizationId String
  sponsorId      String
  sponsor        Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  /// LEAGUE | TOURNAMENT | TEAM | ORG
  scopeType      String
  scopeId        String?
  packageId      String?
  package        SponsorshipPackage? @relation(fields: [packageId], references: [id])
  amountCents    Int      @default(0)
  /// PROSPECT | COMMITTED | ACTIVE | DECLINED | ARCHIVED
  status         String   @default("PROSPECT")
  /// Free-text benefits/term for a custom deal that isn't a catalog package.
  benefitsNote   String?
  notes          String?
  /// Who secured it — the coach who sourced a team sponsor, or an admin.
  securedById    String?
  /// Optional link to a Payment when the sponsorship fee is collected on-platform.
  paymentId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, scopeType, scopeId])
  @@index([sponsorId])
}
