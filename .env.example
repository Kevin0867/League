# Database — Postgres in production; SQLite for local dev is fine.
DATABASE_URL="file:./dev.db"

# Auth — generate a strong secret for production (openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me-in-production-please-0000000000"

# Stripe (hosted checkout) — leave blank until keys are provisioned
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
