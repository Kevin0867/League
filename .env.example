# Database — PostgreSQL. DATABASE_URL is the app connection (may be pooled);
# DIRECT_URL is the direct connection used for migrations. Locally they match.
DATABASE_URL="postgresql://pure:pure@127.0.0.1:5432/pure_academy?schema=public"
DIRECT_URL="postgresql://pure:pure@127.0.0.1:5432/pure_academy?schema=public"

# Auth — generate a strong secret for production (openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me-in-production-please-0000000000"

# Field-level encryption key for minors' data, medical disclosures, and
# emergency contacts (§18). 32 bytes, base64: `openssl rand -base64 32`.
# If unset, a dev key is derived from AUTH_SECRET. Production MUST set this.
FIELD_ENCRYPTION_KEY=""

# Stripe (hosted checkout) — leave blank until keys are provisioned
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# SMS (Twilio) — time-critical alerts: cancellations, 48-hour confirmations.
# Leave blank to simulate sends (recorded with delivery status, nothing sent).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email (Resend) — in-platform messages are mirrored to email. Leave blank to
# simulate. EMAIL_FROM is the verified sender address.
RESEND_API_KEY=""
EMAIL_FROM="PURE Academy <noreply@purepickleball.com>"

# Intake API — external signup sources POST registrations to
# /api/intake/registration with header `x-api-key: <this value>`. Generate a
# long random value; leave blank to disable the endpoint.
INTAKE_API_KEY=""

# Optional: require this token on the first-run /setup admin page (extra safety
# on a public deploy). Leave blank to rely on the zero-users guard alone.
SETUP_TOKEN=""

# App — set to the deployed origin in production (used for Stripe redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
